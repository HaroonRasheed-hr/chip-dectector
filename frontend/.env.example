# Copy this file to .env.local and fill in your values

# Backend API base URL (no trailing slash).
# Leave EMPTY (the default) when the backend serves the frontend build — the
# app then calls the API on whatever origin the page was loaded from, so both
# http://localhost:8000 and http://127.0.0.1:8000 work from one build.
# Only set this when the API lives on a different host/port.
NEXT_PUBLIC_API_URL=

# Auth endpoints (relative to NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_AUTH_REGISTER_PATH=/auth/register

# Inference endpoint (relative to NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_INFER_PATH=/infer
