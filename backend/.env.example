# Copy this file to .env and fill in your values
# Never commit the real .env to version control

# Django
SECRET_KEY=your-very-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database — SQLite (default for development, no extra config needed)
# DATABASE_URL=sqlite:///db.sqlite3

# Uncomment and fill in when switching to PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/visionpulse

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# JWT token lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Set to True in production (requires HTTPS)
REFRESH_COOKIE_SECURE=False
